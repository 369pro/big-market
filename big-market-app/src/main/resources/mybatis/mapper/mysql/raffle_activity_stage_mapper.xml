<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pro.infrastructure.dao.IRaffleActivityStageDao">

    <resultMap id="dataMap" type="com.pro.infrastructure.dao.po.RaffleActivityStage">
        <id column="id" property="id"/>
        <result column="channel" property="channel"/>
        <result column="source" property="source"/>
        <result column="activity_id" property="activityId"/>
        <result column="activity_name" property="activityName"/>
        <result column="activity_desc" property="activityDesc"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="activity_state" property="activityState"/>
        <result column="begin_date_time" property="beginDateTime"/>
        <result column="end_date_time" property="endDateTime"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.pro.infrastructure.dao.po.RaffleActivityStage">
        insert into raffle_activity_stage(channel, source, activity_id, state, create_time, update_time)
        values (
        #{channel},#{source},#{activityId},#{state},now(),now()
        )
    </insert>
    
    <update id="updateStageActivity2ActiveById" parameterType="java.lang.Long">
        update raffle_activity_stage set state = 'active'
        where id = #{id}
    </update>

    <select id="queryStageActivity2ActiveById" parameterType="java.lang.Long" resultType="java.lang.Long">
        select activity_id from raffle_activity_stage where id = #{id}
    </select>

    <select id="queryStageActiveBySC" parameterType="com.pro.infrastructure.dao.po.RaffleActivityStage" resultType="java.lang.Long">
        select activity_id from raffle_activity_stage
        where
            channel = #{channel} and
            source = #{source} and
            state = 'active'
        limit 1
    </select>

    <select id="queryStageActivityList" resultMap="dataMap">
        select s.id, s.channel, s.source, s.activity_id, s.state, s.create_time, s.update_time,
               a.activity_name, a.activity_desc, a.strategy_id, a.state as activity_state,
               a.begin_date_time, a.end_date_time
        from raffle_activity_stage s
        left join raffle_activity a on a.activity_id = s.activity_id
        order by s.id desc
    </select>

</mapper>
