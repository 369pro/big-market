    style R fill:#F8FAFC,stroke:#94A3B8,color:#111827,stroke-width:1.5px;
    style S fill:#F8FAFC,stroke:#94A3B8,color:#111827,stroke-width:1.5px;
    style A fill:#F8FAFC,stroke:#94A3B8,color:#111827,stroke-width:1.5px;

    class U,END input;
    class C,P1,P2,P3,P4,P5,P6,R1,R2,R2B,R3,R9,A1,A2,A3,A4 sync;
    class R4,R5,R6,R7,R8,S3,S4,S5,S14,S15,S18,S19 redis;
    class S1,S2,S6,S7,S8,S11,S12,S13,A5,A6,A7,A8,A9,A10 mq;
    class S9,S10,S16,S17,A11,A12,A13,A14 db;
    class GAP,GAP2,GAP3,GAP4 warn;
